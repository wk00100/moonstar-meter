    "@unhead/vue": "^2.1.17",
    "bootstrap": "^5.3.8",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue3-carousel": "^0.19.0"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
